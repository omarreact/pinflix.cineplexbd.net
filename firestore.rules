rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model:
    // users/{uid}/watchlist/{movieId}
    //   ownerUid: string, required and immutable; must match the authenticated UID.
    //   movieId: string, required and immutable; must match the numeric movie ID.
    //   movie: map, required; bounded, normalized movie-card metadata only.
    //   savedAt: timestamp, required and immutable; assigned by serverTimestamp().
    // No user profile or contact information is stored in Firestore.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return 'ownerUid' in request.resource.data &&
        request.resource.data.ownerUid == request.auth.uid;
    }

    function uidNotModified() {
      return 'ownerUid' in request.resource.data &&
        'ownerUid' in resource.data &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.ownerUid == request.auth.uid;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isValidImagePath(path) {
      return path == null ||
        (path is string && path.size() <= 255 &&
          path.matches("^/[A-Za-z0-9_./-]+\\.(jpg|png|webp|svg)$"));
    }

    function isValidOptionalTagline(data) {
      return !('tagline' in data) ||
        (data.tagline is string && data.tagline.size() <= 300);
    }

    function isValidGenres(genres) {
      return genres is list && genres.size() <= 20 &&
        genres.hasOnly([
          'Action', 'Adventure', 'Animation', 'Comedy', 'Crime',
          'Documentary', 'Drama', 'Family', 'Fantasy', 'Foreign',
          'History', 'Horror', 'Music', 'Mystery', 'Romance',
          'Science Fiction', 'TV Movie', 'Thriller', 'War', 'Western'
        ]);
    }

    function isValidMovie(movie) {
      return movie is map &&
        hasRequiredFields(movie, [
          'id', 'title', 'overview', 'releaseDate', 'rating',
          'posterPath', 'backdropPath', 'genres', 'runtime', 'language'
        ]) &&
        hasOnlyAllowedFields(movie, [
          'id', 'title', 'overview', 'releaseDate', 'rating',
          'posterPath', 'backdropPath', 'genres', 'runtime', 'language', 'tagline'
        ]) &&
        movie.id is int && movie.id > 0 && movie.id <= 2147483647 &&
        movie.title is string && movie.title.size() > 0 && movie.title.size() <= 200 &&
        movie.overview is string && movie.overview.size() <= 5000 &&
        movie.releaseDate is string && movie.releaseDate.size() <= 32 &&
        movie.rating is number && movie.rating >= 0 && movie.rating <= 10 &&
        isValidImagePath(movie.posterPath) &&
        isValidImagePath(movie.backdropPath) &&
        isValidGenres(movie.genres) &&
        (movie.runtime == null ||
          (movie.runtime is number && movie.runtime >= 0 && movie.runtime <= 1000)) &&
        movie.language is string && movie.language.size() <= 8 &&
        isValidOptionalTagline(movie);
    }

    function isValidWatchlist(data, movieId) {
      return data is map &&
        hasRequiredFields(data, ['ownerUid', 'movieId', 'movie', 'savedAt']) &&
        hasOnlyAllowedFields(data, ['ownerUid', 'movieId', 'movie', 'savedAt']) &&
        data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128 &&
        data.movieId is string && data.movieId == movieId &&
        isValidMovie(data.movie) &&
        data.savedAt is timestamp;
    }

    function isRecent(time) {
      return time is timestamp &&
        time > request.time - duration.value(5, 'm') &&
        time <= request.time;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    match /users/{userId}/watchlist/{movieId} {
      allow read: if isOwner(userId) && resource.data.ownerUid == userId;
      allow create: if isOwner(userId) &&
        uidUnchanged() &&
        isValidWatchlist(request.resource.data, movieId) &&
        isRecent(request.resource.data.savedAt);
      allow update: if isOwner(userId) &&
        uidNotModified() &&
        isValidWatchlist(request.resource.data, movieId) &&
        areImmutableFieldsUnchanged(['ownerUid', 'movieId', 'savedAt']) &&
        request.resource.data.movie.id == resource.data.movie.id;
      allow delete: if isOwner(userId) && resource.data.ownerUid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
